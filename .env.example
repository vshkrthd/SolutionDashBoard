# Copy to .env; do not commit credentials.
SPLUNK_URL=https://splunk.example.com:8089
SPLUNK_TOKEN=
# Map your index fields into these canonical names (replace the example index and field names).
SPLUNK_SEARCH=search index=your_index | eval solution_id=coalesce(service_id,app) | eval event_id=coalesce(request_id,_cd) | eval timestamp=strftime(_time,"%Y-%m-%dT%H:%M:%SZ") | eval status_code=coalesce(http_status,200) | eval duration_ms=coalesce(elapsed_ms,0) | eval trace_id=coalesce(trace_id,request_id) | table event_id solution_id timestamp status_code duration_ms trace_id
